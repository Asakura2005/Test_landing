# ==========================================
# HAQ FOOD B2B PORTAL - ENVIRONMENT CONFIG
# ==========================================
# ⚠️ KHÔNG commit file .env thật vào Git!
# Copy file này thành .env và điền giá trị thật.

# ── Frontend (.env trong frontend/)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_POSTHOG_KEY=your-posthog-key-here
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_BACKEND_API_URL=https://your-backend.onrender.com/api
VITE_ENCRYPTION_SALT=your-encryption-salt-here

# ── Backend (.env trong backend/)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
PORT=3001
JWT_SECRET=your-jwt-secret-at-least-32-chars-long-here

# SMTP Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM_NAME=HAQ FOOD Việt Nam
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# Resend API (HTTPS Port 443)
RESEND_API_KEY=re_your_resend_key_here

# Zalo OA
ZALO_APP_ID=your-zalo-app-id
ZALO_APP_SECRET=your-zalo-app-secret
ZALO_ADMIN_USER_ID=your-zalo-user-id
ZALO_OA_ACCESS_TOKEN=your-access-token
ZALO_OA_REFRESH_TOKEN=your-refresh-token
